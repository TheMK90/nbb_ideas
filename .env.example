# Copy this file to .env.local and fill in your own Supabase values.
# Find them in Supabase under Project Settings -> API.
#
# NEXT_PUBLIC_ means Next.js ships these to the browser, which is correct here:
# the anon key is the public client-side key. Never put a service_role key in a
# NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
